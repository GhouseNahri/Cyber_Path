# Cyber_Path environment variables — copy to .env.local and fill in.
# NEVER commit .env.local. Secrets live only in this file locally and in
# the Vercel/Supabase dashboards in production.

# ── Supabase (Phases 2–3) ────────────────────────────────────────────────
# Project URL and anon/public key from Supabase → Project Settings → API.
# The anon key is safe for the browser; it is NOT a secret (RLS protects data).
# The service_role key must NEVER go into this file or the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI assistant (server-only; NEVER prefix with NEXT_PUBLIC_) ──────────────
# Get a free key: https://aistudio.google.com → "Get API key"
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_API_KEY=
